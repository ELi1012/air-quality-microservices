# note: run `npm run init` first to initalize tables

# HOME=~/projects/air_quality/IST VM/srv/images/cron-provider1/

# crontab runs from /root by default
# use this first: `cd /srv`


# sync purpleair sensor data
*/30 * * * * cd /srv && /usr/bin/npm run sync-pa > /proc/1/fd/1 2>/proc/1/fd/2

# sync ECCC regional AQHI data
20,30,40 * * * * cd /srv && /usr/bin/npm run sync-eccc-aqhi > /proc/1/fd/1 2>/proc/1/fd/2


# sync metadata

0 0 1 * * cd /srv && /usr/bin/npm run sync-pa-meta > /proc/1/fd/1 2>/proc/1/fd/2
5 0 1 * * cd /srv && /usr/bin/npm run sync-eccc-region-meta > /proc/1/fd/1 2>/proc/1/fd/2

