{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["init.js", "**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "**/services/stations/*.ts",
    "**/azure/*.ts",
    "**/azure/*.js",
    "**/logs/",
    "**/outputs/",
    "**/archived/*.ts",
  ],
}